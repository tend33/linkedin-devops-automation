pipeline {
    agent { label 'docker' }
    options { disableConcurrentBuilds(); timestamps() }
    parameters {
        string(name: 'PROJECT_DIR', defaultValue: '', description: 'Project path on Docker host and agent; or set LINKEDIN_PROJECT_DIR on the agent.')
        string(name: 'GENERATE_BUILD', defaultValue: '', description: 'Generation build number; blank selects latest manifest.')
    }
    stages {
        stage('Select and snapshot for review') {
            steps {
                sh '''
                    set -eu
                    cd "${PROJECT_DIR:-${LINKEDIN_PROJECT_DIR:?Set PROJECT_DIR or LINKEDIN_PROJECT_DIR}}"
                    case "${GENERATE_BUILD:-}" in *[!0-9]*) echo 'Build number must be numeric'; exit 1;; esac
                    MANIFEST="jenkins-builds/${GENERATE_BUILD:-latest}.env"
                    test -f "$MANIFEST"
                    DRAFT_FILE=$(sed -n 's/^DRAFT_FILE=//p' "$MANIFEST")
                    case "$DRAFT_FILE" in ''|*[!a-zA-Z0-9._-]*) echo 'Invalid draft name'; exit 1;; esac
                    test -f "drafts/$DRAFT_FILE"
                    PREFIX=${DRAFT_FILE%.json}
                    test -f "images/$PREFIX.png"
                    SUMMARY=$(docker compose run --rm -T linkedin-auto --base-dir /app --draft-json "/app/drafts/$DRAFT_FILE" --review-summary)
                    DIGEST=$(printf '%s' "$SUMMARY" | jq -r .digest)
                    rm -rf "$WORKSPACE/review"
                    mkdir -p "$WORKSPACE/review"
                    printf '%s' "$SUMMARY" > "$WORKSPACE/review/publication.json"
                    cat "$WORKSPACE/review/publication.json"
                    cp "drafts/$DRAFT_FILE" "$WORKSPACE/review/draft.json"
                    cp "images/$PREFIX.png" "$WORKSPACE/review/image.png"
                    jq -r '.post_text' "$WORKSPACE/review/draft.json" > "$WORKSPACE/review/post.txt"
                    jq '.research // {}' "$WORKSPACE/review/draft.json" > "$WORKSPACE/review/research.json"
                    # Recheck after copying: an edit during capture invalidates this review.
                    CHECK=$(docker compose run --rm -T linkedin-auto --base-dir /app --draft-json "/app/drafts/$DRAFT_FILE" --review-digest)
                    test "$CHECK" = "$DIGEST"
                    printf '%s' "$DRAFT_FILE" > "$WORKSPACE/draft-name"
                    printf '%s' "$DIGEST" > "$WORKSPACE/review-digest"
                    cat "$WORKSPACE/review/post.txt"
                    cat "$WORKSPACE/review/research.json"
                '''
                archiveArtifacts(artifacts: 'review/*', fingerprint: true)
            }
        }
        stage('Human approval') {
            steps {
                script {
                    // Jenkins Job/Build and Job/Cancel permissions must be restricted to the owner.
                    env.APPROVED_BY = input(message: "Review saved text, image.png and research in ${env.BUILD_URL}artifact/review/. AI-prefilled content is subject to the dashboard privacy notice. Edit in the dashboard or source draft and rerun this job if needed. Approve this exact draft and image for PUBLIC posting to the connected member account?", ok: 'Approve public publication', submitterParameter: 'APPROVER')
                }
            }
        }
        stage('Approve version and publish through shared safety boundary') {
            steps {
                sh '''
                    set -eu
                    cd "${PROJECT_DIR:-${LINKEDIN_PROJECT_DIR:?Set project path}}"
                    DRAFT_FILE=$(cat "$WORKSPACE/draft-name")
                    DIGEST=$(cat "$WORKSPACE/review-digest")
                    docker compose run --rm -T linkedin-auto --base-dir /app \
                        --draft-json "/app/drafts/$DRAFT_FILE" --approve \
                        --expected-digest "$DIGEST" --approved-by "$APPROVED_BY"
                    docker compose run --rm -T linkedin-auto --base-dir /app \
                        --draft-json "/app/drafts/$DRAFT_FILE" --publish
                '''
            }
        }
    }
    post {
        success { echo 'Published; shared publication receipt saved.' }
        aborted { echo 'Publication cancelled.' }
        failure { echo 'Stopped. Reconcile LinkedIn status before retrying or removing any publishing lock.' }
    }
}
