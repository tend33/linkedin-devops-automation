OPENAI_API_KEY=YOUR_OPENAI_API_KEY
LINKEDIN_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_MEMBER_ID=YOUR_LINKEDIN_MEMBER_ID

OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
LINKEDIN_VERSION=202608

# Random independent secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
APPROVAL_SIGNING_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Generate interactively; do not put the plaintext password in shell history.
# python -c "import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass.getpass()))"
DASHBOARD_PASSWORD_HASH=
DASHBOARD_USERNAME=owner
SESSION_COOKIE_SECURE=true
# HTTPS reverse proxy, or localhost SSH tunnel (set secure cookies false for localhost HTTP only).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-private-host/linkedin/callback
# Legacy personal token migration only; Unix timestamp from actual token expiry and granted scope.
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_SCOPES=w_member_social
# Optional host path for Compose; default is the project directory.
LINKEDIN_PROJECT_DIR=.
